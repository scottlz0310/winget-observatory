{
  "name": "winget-observatory",
  "version": "0.2.0",
  "private": true,
  "description": "Observation and analytics tools for microsoft/winget-pkgs review triage queue",
  "type": "module",
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p workers/observe-trigger/tsconfig.json",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepare": "lefthook install",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov",
    "build:pages": "bun run scripts/build-pages.ts",
    "sync:dropbox": "bun run scripts/sync-dropbox.ts",
    "explore:depths": "bun run src/cli/explore-depths.ts",
    "progress": "bun run src/cli/progress.ts",
    "sync:secrets": "bun run scripts/sync-worker-secrets.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "lefthook"
  ]
}
