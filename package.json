{
  "name": "winget-observatory",
  "version": "0.7.0",
  "private": true,
  "description": "Observation and analytics tools for microsoft/winget-pkgs review triage queue",
  "type": "module",
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p workers/observe-trigger/tsconfig.json && tsc --noEmit -p packages/verify-gate/tsconfig.json",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepare": "lefthook install",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov",
    "build:pages": "bun run scripts/build-pages.ts",
    "build:verify-gate": "bun run packages/verify-gate/scripts/build.ts",
    "sync:dropbox": "bun run scripts/sync-dropbox.ts",
    "explore:depths": "bun run src/cli/explore-depths.ts",
    "progress": "bun run src/cli/progress.ts",
    "collect:feedback": "bun run src/cli/collect-review-feedback.ts",
    "verify:gate": "bun run packages/verify-gate/src/cli.ts",
    "sync:secrets": "bun run scripts/sync-worker-secrets.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/bun": "^1.4.5",
    "lefthook": "^2.2.2",
    "oxc-parser": "^0.160.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "lefthook"
  ]
}
