{
  "name": "winget-observatory",
  "version": "0.1.0",
  "private": true,
  "description": "Observation and analytics tools for microsoft/winget-pkgs review triage queue",
  "type": "module",
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "prepare": "lefthook install",
    "test": "bun test",
    "build:pages": "bun run scripts/build-pages.ts",
    "sync:dropbox": "bun run scripts/sync-dropbox.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "lefthook": "^2.2.2"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "lefthook"
  ]
}
